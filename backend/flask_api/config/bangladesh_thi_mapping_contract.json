  "formula": {
    "expression": "(1.8 * T + 32) - ((0.55 - 0.0055 * RH) * (1.8 * T - 26))",
    "temperature_symbol": "T",
    "temperature_unit": "degrees Celsius",
    "humidity_symbol": "RH",
    "humidity_unit": "percent",
    "article_doi": "10.1016/j.anopes.2026.100139",
    "local_evidence": [
      "backend/flask_api/ml/reports/bangladesh_dataset_inventory.json",
      "documentation/bangladesh_dataset_methodology_summary.md",
      "documentation/bangladesh_integration_approval_gate.md"
    ],
    "verified": true
  },
  "categories": [
    {
      "label": "T0",
      "minimum": null,
      "minimum_inclusive": false,
      "maximum": 75.0,
      "maximum_inclusive": true,
      "rule": "THI <= 75"
    },
    {
      "label": "T1",
      "minimum": 75.0,
      "minimum_inclusive": false,
      "maximum": 80.0,
      "maximum_inclusive": false,
      "rule": "75 < THI < 80"
    },
    {
      "label": "T2",
      "minimum": 80.0,
      "minimum_inclusive": true,
      "maximum": null,
      "maximum_inclusive": false,
      "rule": "THI >= 80"
    }
  ],
  "pipeline_category_labels_verified": [
    "T0",
    "T1",
    "T2"
  ],
  "boundary_policy": {
